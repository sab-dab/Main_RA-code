depth_stats <- depth_df %>%
  group_by(Group) %>%
  summarise(
    n = n(),
    mean_depth = mean(Depth, na.rm = TRUE),
    median_depth = median(Depth, na.rm = TRUE),
    sd_depth = sd(Depth, na.rm = TRUE),
