  tibble(
    Model = model_name,
    Accuracy = yardstick::accuracy(preds, truth = Group, estimate = .pred_class)$.estimate,
    Sensitivity = yardstick::sens(preds, truth = Group, estimate = .pred_class, event_level = "second")$.estimate,
    Specificity = yardstick::spec(preds, truth = Group, estimate = .pred_class, event_level = "second")$.estimate,
    ROC_AUC = yardstick::roc_auc(preds, truth = Group, .pred_RA, event_level = "second")$.estimate
  )
}

