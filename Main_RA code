)

median_iqr <- function(x) {
  med <- median(x, na.rm = TRUE)
  q1  <- quantile(x, 0.25, na.rm = TRUE)
  q3  <- quantile(x, 0.75, na.rm = TRUE)
  sprintf("%.3f (%.3f–%.3f)", med, q1, q3)
}

cohort_summary <- alpha_df %>%
  group_by(Group) %>%
  summarise(
    n = n(),
    Shannon_median_IQR  = median_iqr(Shannon),
    Richness_median_IQR = median_iqr(Richness),
    .groups = "drop"
  )

print(cohort_summary)
write.csv(
  cohort_summary,
  file.path(save_dir, "Table_Cohort_Summary.csv"),
  row.names = FALSE
)

print(wilcox.test(Shannon ~ Group, data = alpha_df))
print(wilcox.test(Richness ~ Group, data = alpha_df))

