    max_depth = max(Depth, na.rm = TRUE),
    .groups = "drop"
  )

print(depth_stats)
write.csv(
  depth_stats,
  file.path(save_dir, "Table_Sequencing_Depth_Summary.csv"),
  row.names = FALSE
)

