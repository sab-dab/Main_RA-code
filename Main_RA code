  group_by(Genus) %>%
  summarise(across(all_of(sample_cols), \(x) sum(x, na.rm = TRUE)), .groups = "drop")

genus_rel <- genus_abund
genus_rel[, sample_cols] <- sweep(
  genus_rel[, sample_cols],
