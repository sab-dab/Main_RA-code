p_shannon <- ggplot(alpha_df, aes(x = Group, y = Shannon, fill = Group)) +
  geom_boxplot() +
  geom_jitter(width = 0.15, alpha = 0.35, size = 1) +
  theme_minimal(base_size = 14) +
