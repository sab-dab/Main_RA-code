# =============================================================================
tax_abund <- tax_info_df %>%
  left_join(asv_profile_df, by = "ASV") %>%
  mutate(Genus = str_extract(Taxon, "g__[^;]+")) %>%
  mutate(Genus = ifelse(is.na(Genus), "g__Unknown", Genus))

